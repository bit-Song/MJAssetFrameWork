' ========== Relationships ==========

' Framework Core
MJAssetsABFrame --|> MJABFrameBase
MJAssetsABFrames ..> MJAssetsABFrame : partial class

' MJAssetsABFrame holds interfaces
MJAssetsABFrame *-- IHotAssets : mHotAssets
MJAssetsABFrame *-- IResourcesInterface : mResources
MJAssetsABFrame *-- IDecompressAssets : mDecompressAssets

' Interface implementations
HotAssetsManager ..|> IHotAssets
ResourcesManager ..|> IResourcesInterface
AssetsDecompressManager --|> IDecompressAssets

' BundleHot relationships
HotAssetsManager *-- HotAssetsModule : manages
HotAssetsModule *-- AssetDownLoader : creates
AssetDownLoader *-- DownLoadThread : manages
HotAssetsModule *-- HotAssetsManifest : downloads
HotAssetsManifest *-- HotAssetsPatch : contains
HotAssetsPatch *-- HotFileInfo : contains
HotAssetsManager *-- WaitDownLoadModule : queues
HotAssetsModule --> CheckVersionResult : returns

' HotUpdateManager orchestrates
HotUpdateManager --> MJAssetsABFrame : calls API
HotUpdateManager --> HotAssetsWindow : controls UI
HotUpdateManager --> AssetBundleManager : loads config after hot update

' BundleLoad relationships
ResourcesManager --> AssetBundleManager : loads AB
AssetBundleManager *-- BundleItem : manages
AssetBundleManager *-- AssetBundleCache : caches
AssetBundleManager --> ClassObjectPool : uses pool
ResourcesManager *-- CacheObject : pools
ResourcesManager --> ClassObjectPool : uses pool

' Config relationships
BundleConfig *-- BundleInfo : contains
BundleSettings *-- BundleEncryptToggle
BundleModuleData *-- BundleFileInfo : contains

' Editor relationships
BuildWindow *-- BuildBundleWindow
BuildWindow *-- BuildHotPatchWindow
BuildWindow *-- LeftMenuWinow
BuildBundleWindow --|> BundleBehaviour
BuildHotPatchWindow --|> BundleBehaviour
BundleModuleConfig *-- ArrayWindow
BundleModuleConfig *-- SignArrayWindow
BuildBundleConfigura *-- BundleModuleData : contains
BuildBundleCompiler --> BundleConfig : generates
BuildBundleCompiler --> HotAssetsManifest : generates
BuildBundleCompiler --> BuiltinBundleInfo : generates
BuildBundleCompiler --> BundleSettings : reads config
BundleTools --> BundleModuleEnum : generates

' Demo relationships
Test --> MJAssetsABFrame : initializes
Test --> HotUpdateManager : starts flow
GameModeItem --> MJAssetsABFrame : calls API
GameModeItem --> HotAssetsModule : reads progress
LoginWindow --> MJAssetsABFrame : calls API
ButtonClick --> MJAssetsABFrame : calls API

' Data flow
HotAssetsModule --> BundleSettings : reads config
AssetBundleManager --> BundleSettings : reads config
ResourcesManager --> BundleSettings : reads config
DownLoadThread --> HotAssetsModule : reports progress

@enduml
